+def _grug_representative_action_coordinates(
+    *, sequence_length: int, num_actions: int, microbatch: int
+) -> list[dict[str, int | str]]:
+    """Name the three frozen action samples and their causal-model positions."""
+
+    if sequence_length <= 1 or num_actions <= 0 or num_actions >= sequence_length:
+        raise ValueError(f"invalid sequence/action lengths: sequence={sequence_length}, actions={num_actions}")
+    action_indices = (0, num_actions // 2, num_actions - 1)
+    model_start = sequence_length - num_actions - 1
