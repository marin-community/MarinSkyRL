+def parse_route_discriminator_targets(values: list[str]) -> list[dict[str, int | str]]:
+    targets = []
+    seen = set()
+    for value in values:
+        fields = value.split(":")
+        if len(fields) != 3:
+            raise ValueError(f"invalid route-discriminator target {value!r}")
+        rank_text, microbatch_text, position = fields
+        position = position.lower()
+        if position not in {"first", "middle", "last"}:
+            raise ValueError(f"invalid route-discriminator position {position!r}")
+        rank = int(rank_text)
+        microbatch = int(microbatch_text)
+        if rank < 0 or microbatch < 0:
+            raise ValueError(f"route-discriminator coordinates must be nonnegative: {value!r}")
+        key = (rank, microbatch, position)
+        if key in seen:
+            raise ValueError(f"duplicate route-discriminator target {value!r}")
+        seen.add(key)
+        targets.append({"rank": rank, "microbatch": microbatch, "representative_position": position})
+    return targets
+
+
+def order_route_discriminator_targets(targets: list[dict[str, int | str]]) -> list[dict[str, int | str]]:
+    """Order coordinates by rank, microbatch, then frozen action-sample order."""
+
+    position_order = {"first": 0, "middle": 1, "last": 2}
+    return sorted(
+        targets,
+        key=lambda item: (
+            int(item["rank"]),
+            int(item["microbatch"]),
+            position_order[str(item["representative_position"])],
+        ),
+    )
+
