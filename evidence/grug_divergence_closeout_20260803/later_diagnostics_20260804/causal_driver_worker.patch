+def compare_paired_output_fingerprints(candidate: dict[str, Any], reference: dict[str, Any]) -> dict[str, Any]:
+    """Check that diagnostic hooks leave the frozen output samples bitwise unchanged."""
+
+    if len(candidate["timed_workers"]) != len(reference["timed_workers"]):
+        raise RuntimeError("paired output-fingerprint worker counts differ")
+    mismatches = []
+    checked = 0
+    for candidate_worker, reference_worker in zip(candidate["timed_workers"], reference["timed_workers"]):
+        if candidate_worker["rank"] != reference_worker["rank"]:
+            raise RuntimeError("paired output-fingerprint worker ranks differ")
+        if (
+            candidate_worker["representative_action_log_prob_coordinates"]
+            != reference_worker["representative_action_log_prob_coordinates"]
+        ):
+            raise RuntimeError("paired output-fingerprint coordinates differ")
+        checked += len(reference_worker["representative_action_log_probs"])
+        if (
+            candidate_worker["representative_action_log_probs_sha256"]
+            != reference_worker["representative_action_log_probs_sha256"]
+        ):
+            mismatches.append(
+                {
+                    "rank": reference_worker["rank"],
+                    "reference_sha256": reference_worker["representative_action_log_probs_sha256"],
+                    "candidate_sha256": candidate_worker["representative_action_log_probs_sha256"],
+                }
+            )
+    return {
+        "checked": checked,
+        "mismatched_workers": len(mismatches),
+        "mismatches": mismatches,
+        "passed": not mismatches,
+    }
+
