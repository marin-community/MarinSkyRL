# syntax=docker/dockerfile:1
#
# gpu-rl-arm64 — the aarch64 counterpart of docker/Dockerfile.gpu-rl.
#
# linux/arm64, from-source CUDA, for Grace Hopper GH200 and Grace Blackwell
# GB200 systems. The host CPU requires an arm64 image; native extensions carry
# both sm_90 and sm_100 kernels.
#
# WHY A SEPARATE FILE, NOT ARCH-CONDITIONAL ARGS IN Dockerfile.gpu-rl
# -------------------------------------------------------------------
# The two images differ in more than a flag. The arch list, wheel platform, nvcc
# job width, and architecture-specific native artifacts are different. Expressing
# that as `if` branches inside the heavy
# RUN steps of Dockerfile.gpu-rl would put arm64-only shell inside every layer of
# the image that production is digest-pinned to, where a mistake silently changes
# the amd64 closure. docker/build_gpu_rl_kaniko.sh already selects the Dockerfile
# through $DOCKERFILE and reads the baked pins out of whichever file it is given,
# so a second file needs no build-script change to be usable.
#
# The cost is duplication. Both files carry a pointer to the other; a change to
# one is a change to both.
#
# HOW MEGATRON IS INSTALLED HERE
# ------------------------------
# The root `megatron` extra resolves the backend on aarch64 and pins the
# architecture-specific native wheels. Selecting it can no longer succeed while
# installing no backend. Every piece exists (verified against PyPI and the
# upstream GitHub releases on 2026-07-28):
#   transformer_engine        2.11.0  py3-none-any                  (PyPI)
#   transformer_engine_cu12   2.11.0  py3-none-manylinux_2_28_aarch64 (PyPI)
#   transformer_engine_torch  2.11.0  cp312-linux_aarch64  (erictang000 release)
#   megatron_core             0.18.0  cp312-manylinux_2_28_aarch64  (PyPI)
#   megatron_bridge           0.5.0   py3-none-any                  (PyPI)
#   mamba_ssm / causal_conv1d         cp312-linux_aarch64  (erictang000 releases)
# No TransformerEngine source build is required. The whole Megatron subtree has
# aarch64 wheels, and the root lock records the architecture-specific native
# artifacts for both supported Linux platforms.
#
# The image installs the root project's dependency closure directly from
# `uv.lock`; the architecture-specific native artifacts are part of that frozen
# resolution. On
# top of that closure it installs flash-attn from its validated wheel and the
# exact vLLM fork source with validated precompiled native extensions. The
# unified source tree is baked into the image.
#
# Consumed by the iris RL launcher (digest-pinned). Built in-cluster via kaniko
# (docker/build_gpu_rl_kaniko.sh) on an aarch64 build host — kaniko builds for the
# architecture it runs on, so an arm64 iris job on cw-us-east-08a produces an
# arm64 image with no cross-compilation. See the build-gpu-rl-image-iris skill.
#
# =============================================================================
# WHEEL BUILD
# =============================================================================
# The two SLOW steps are the from-source nvcc compiles of the vLLM FORK (cutlass
# GEMM kernels) and flash-attn 2.8.3 (its flash_attn_2_cuda extension). They are
# isolated in the `wheel-builder` stage, which emits RELOCATABLE WHEELS.
# There is no prebuilt alternative, unlike the amd64 file: the published wheelhouse
# artifact holds linux_x86_64 wheels and cannot satisfy an aarch64 build, so this
# image always compiles. Build the two architectures used by the aarch64 fleet:
# Hopper (9.0) for GH200 systems such as JSC Jupiter and Blackwell (10.0) for GB200.
# NATIVE CACHE KEY = { VLLM_FORK_COMMIT, FLASH_ATTN_VERSION, torch
#   2.11.0, CUDA 12.9, cp312, aarch64, TORCH_CUDA_ARCH_LIST "9.0;10.0" }.
#
# =============================================================================
# Version pins (ground truth = root pyproject.toml + uv.lock):
#   - torch 2.11.0+cu129 : the root project pins torch to the cu129 index, matching
#       the 12.9 toolkit below. The two move together on purpose. An earlier
#       attempt raised only the toolkit and left torch on cu128; a split
#       toolchain builds but leaves a native extension linked against one CUDA
#       minor and loaded against another, which fails at runtime rather than at
#       build time. Keep this index and BASE_IMAGE in step.
#   - vLLM fork          : Python source and metadata come from
#       marin-community/vllm @ VLLM_FORK_COMMIT. The lock uses stock vLLM 0.23.0
#       as its dependency anchor; native files come from the validated donor.
#   - flash-attn 2.8.3   : compiled from source vs torch 2.11.0+cu129 / cp312 so
#       flash_attn_2_cuda EXISTS (the root lock pins flash-attn 2.8.3; a
#       `--no-deps` wheel swap here is the version that actually runs).
#   - transformers 5.8.1 : root package pin (>=5.8.1,<5.9), required by the
#       megatron backend (megatron-bridge 0.5.0). vLLM 0.23.0 accepts it.
#   - python 3.12 / CUDA 12.9 (devel base, for nvcc). 12.9 is a FLOOR, not a
#       preference: the vLLM fork's Blackwell MXFP4 experts kernel static-asserts
#       "MXFP4 experts quant requires PACK16 mode (CUDA >= 12.9)". Enabling sm_100
#       turns that kernel on, so 12.8 cannot build an image that targets GB200.
# Build is GPU-count-agnostic and needs no live GPU (only nvcc). Target = linux/arm64.
# BASE_IMAGE is a multi-arch manifest and resolves its aarch64 child on an aarch64
# builder, so it is the same reference as the amd64 file on purpose.
# =============================================================================

ARG BASE_IMAGE=nvidia/cuda:12.9.2-cudnn-devel-ubuntu22.04
ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG FLASH_ATTN_VERSION=2.8.3
ARG VLLM_FORK_REPO=https://github.com/marin-community/vllm.git
ARG VLLM_FORK_COMMIT=8672c71e311cb76a81154589cb60498b41dd59f7
# Hopper (9.0) and Blackwell (10.0). The arm64 image serves both GH200 and GB200
# hosts, so native extensions must carry kernels for both compute capabilities.
ARG TORCH_CUDA_ARCH_LIST="9.0;10.0"
# The aarch64 build host is a GB200 node: 144 cores and 955 GB RAM, against the
# 48 cores and 512 GB of the amd64 builder. Widen the nvcc fan-out to match, but
# keep it well under the core count: a cutlass translation unit can hold ~10 GB,
# and the amd64 builder OOMs at 256 GB during wheel packaging, so memory rather
# than cores is what bounds this.
ARG MAX_JOBS=24
ARG NVCC_THREADS=2
# Opt-in Megatron training backend. Off by default so the default image is
# fsdp2-only; set INSTALL_MEGATRON=1 to select the root `megatron` extra.
ARG INSTALL_MEGATRON=0
# Harbor (agentic rollout) is installed after the trainer lock. Change this pin in source rather
# than overriding it at build time.
ARG HARBOR_COMMIT=ad6e612d385379d3168638f6bfb2cf4a56cedbf9
ARG FASTAPI_VERSION=0.136.1
ARG OTEL_EXPORTER_VERSION=1.44.0

# =============================================================================
# STAGE 1: wheel-builder — compile the vLLM FORK + flash-attn into wheels (nvcc)
# =============================================================================
FROM ${BASE_IMAGE} AS wheel-builder
ARG TORCHVISION_VERSION

# kaniko builds for the architecture it runs on. Fail in seconds if this file was
# scheduled onto an amd64 builder rather than after a two-hour nvcc compile that
# would then be labelled aarch64 by the MANIFEST below.
RUN test "$(uname -m)" = aarch64 || { echo "Dockerfile.gpu-rl-arm64 needs an aarch64 builder, got $(uname -m)" >&2; exit 1; }

ARG TORCH_VERSION
ARG FLASH_ATTN_VERSION
ARG VLLM_FORK_REPO
ARG VLLM_FORK_COMMIT
ARG TORCH_CUDA_ARCH_LIST
ARG MAX_JOBS
ARG NVCC_THREADS

ENV DEBIAN_FRONTEND=noninteractive
# The in-cluster Kaniko builder occasionally lands on a slow/stalled Ubuntu
# mirror.  Bound each request and retry transient fetch failures instead of
# leaving the build alive indefinitely with no log output.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 update && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 install -y --no-install-recommends \
    git curl ca-certificates build-essential cmake ninja-build \
    python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --upgrade pip uv

ENV UV_HTTP_TIMEOUT=600
ENV UV_RETRIES=5
ENV TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}"
ENV MAX_JOBS="${MAX_JOBS}"
ENV NVCC_THREADS="${NVCC_THREADS}"
ENV VLLM_TARGET_DEVICE=cuda

# Build venv with EXACTLY the torch the wheels must be ABI-compatible with. Both
# from-source builds use --no-build-isolation to reuse THIS torch.
ENV WHEEL_VENV=/opt/wheelbuild/.venv
RUN uv venv --python 3.12 $WHEEL_VENV
RUN . $WHEEL_VENV/bin/activate && \
    uv pip install --extra-index-url https://download.pytorch.org/whl/cu129 \
        --index-strategy unsafe-best-match \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "setuptools_scm" "setuptools-rust>=1.9.0" \
        "setuptools>=77.0.3,<81.0.0" "wheel" "packaging" \
        "ninja" "cmake" "psutil" "pip"

WORKDIR /wheels

# (W1) flash-attn -> wheel. FLASH_ATTENTION_FORCE_BUILD=TRUE so it never silently
# falls back to a (nonexistent) prebuilt torch-2.11 wheel.
RUN . $WHEEL_VENV/bin/activate && \
    MAX_JOBS=$MAX_JOBS NVCC_THREADS=$NVCC_THREADS \
        TORCH_CUDA_ARCH_LIST="$TORCH_CUDA_ARCH_LIST" \
        FLASH_ATTENTION_FORCE_BUILD=TRUE \
        python -m pip wheel "flash-attn==${FLASH_ATTN_VERSION}" \
            --no-build-isolation --no-cache-dir --no-deps -w /wheels

# (W2) vLLM FORK -> wheel. use_existing_torch.py strips the fork's torch pins so
# it builds against the torch above.
ENV VLLM_FORK_DIR=/opt/vllm-fork
RUN git clone $VLLM_FORK_REPO $VLLM_FORK_DIR && \
    git -C $VLLM_FORK_DIR checkout $VLLM_FORK_COMMIT && \
    test "$(git -C $VLLM_FORK_DIR rev-parse HEAD)" = "$VLLM_FORK_COMMIT"
RUN . $WHEEL_VENV/bin/activate && \
    cd $VLLM_FORK_DIR && \
    python use_existing_torch.py && \
    MAX_JOBS=$MAX_JOBS NVCC_THREADS=$NVCC_THREADS TORCH_CUDA_ARCH_LIST="$TORCH_CUDA_ARCH_LIST" \
        VLLM_TARGET_DEVICE=cuda \
        python -m pip wheel . --no-build-isolation --no-deps -w /wheels -v

RUN echo "VLLM_FORK_COMMIT=${VLLM_FORK_COMMIT}" >  /wheels/MANIFEST && \
    echo "FLASH_ATTN_VERSION=${FLASH_ATTN_VERSION}" >> /wheels/MANIFEST && \
    echo "TORCH_VERSION=${TORCH_VERSION}" >> /wheels/MANIFEST && \
    echo "TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}" >> /wheels/MANIFEST && \
    echo "CUDA=12.9 PY=cp312 PLATFORM=linux_aarch64" >> /wheels/MANIFEST && \
    ls -la /wheels

# =============================================================================
# STAGE 2: wheels — always the wheel-builder stage
# =============================================================================
# The amd64 file selects between a prebuilt wheelhouse and a source compile. There
# is no such choice here: the published wheelhouse artifact holds linux_x86_64
# wheels, so aarch64 always pays the compile. build_gpu_rl_kaniko.sh defaults
# WHEEL_SOURCE to wheel-builder on an aarch64 host for the same reason.
FROM wheel-builder AS wheels

# =============================================================================
# STAGE 3: rl — the runtime image (installs from the lock + swaps the wheels)
# =============================================================================
FROM ${BASE_IMAGE} AS rl

RUN test "$(uname -m)" = aarch64 || { echo "Dockerfile.gpu-rl-arm64 needs an aarch64 builder, got $(uname -m)" >&2; exit 1; }

ARG TORCH_VERSION
ARG FLASH_ATTN_VERSION
ARG VLLM_FORK_REPO
ARG VLLM_FORK_COMMIT
ARG TORCH_CUDA_ARCH_LIST
ARG INSTALL_MEGATRON
ARG HARBOR_COMMIT
ARG FASTAPI_VERSION
ARG OTEL_EXPORTER_VERSION
# MarinSkyRL commit this image is built from — recorded in the baked /opt/skyrl
# git tree (see the git-init step below) for provenance.
ARG GITSHA=unknown

LABEL org.opencontainers.image.source="https://github.com/marin-community/MarinSkyRL" \
      org.opencontainers.image.revision="${GITSHA}" \
      org.marin.harbor-commit="${HARBOR_COMMIT}"

ENV DEBIAN_FRONTEND=noninteractive
# InfiniBand / RDMA userspace (rdma-core) — REQUIRED for NCCL's built-in IB
# transport on CoreWeave (Mellanox mlx5 HCAs). NCCL DLOPENs libibverbs.so.1 +
# the libmlx5 provider at runtime; absent, it SILENTLY falls back to NET/Socket
# (TCP). ibverbs-utils adds ibv_devices/ibstat for in-pod IB diagnostics.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 update && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    python3-venv \
    rdma-core \
    ibverbs-providers \
    libibverbs1 \
    librdmacm1 \
    ibverbs-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip uv

ENV UV_HTTP_TIMEOUT=600
ENV UV_RETRIES=5
ENV TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}"

# =============================================================================
# Root marinskyrl project. The built distribution owns cloud.iris, skyrl_train,
# and skyrl_gym, so its frozen extras work both from a wheel and this source tree.
# =============================================================================
ENV SKYRL_HOME=/opt/skyrl
COPY pyproject.toml uv.lock README.md LICENSE ${SKYRL_HOME}/
COPY chat_templates ${SKYRL_HOME}/chat_templates
COPY cloud ${SKYRL_HOME}/cloud
COPY skyrl-train ${SKYRL_HOME}/skyrl-train
COPY skyrl-gym ${SKYRL_HOME}/skyrl-gym
COPY docker/sync_gpu_rl_env.sh /usr/local/bin/sync-gpu-rl-env
RUN chmod 0755 /usr/local/bin/sync-gpu-rl-env

# Make /opt/skyrl a REAL git working tree so the baked MarinSkyRL commit is
# recorded (provenance) and /opt/skyrl serves as a clean baked-HEAD import
# fallback behind the live /app controller bundle. Trainer and example source
# resolve from this baked tree.
# marinskyrl stays editable (uv sync below). This is additive: the
# committed working-tree content is exactly the COPY'd source above (unchanged
# closure); we only add .git + the origin remote.
RUN cd ${SKYRL_HOME} && \
    git init -q -b main && \
    git remote add origin https://github.com/marin-community/MarinSkyRL.git && \
    git -c user.email=gpu-rl-build@marin.local -c user.name=gpu-rl-build add -A && \
    git -c user.email=gpu-rl-build@marin.local -c user.name=gpu-rl-build commit -q -m "baked gpu-rl image content @ ${GITSHA}" && \
    echo "/opt/skyrl git tree baked @ $(git -C ${SKYRL_HOME} rev-parse HEAD) (origin=marin-community/MarinSkyRL, source @ ${GITSHA})"

# =============================================================================
# RL environment — installed directly from the root lock. `vllm` implies the
# CUDA hardware closure; `fsdp` and `megatron` select policy dependencies. When
# INSTALL_MEGATRON=1, `megatron` adds the aarch64 policy backend from the same
# frozen resolution.
# No UV_CONSTRAINT / rl_env_constraints: the lock IS the constraint.
# =============================================================================
# RL venv path MUST match the Iris launcher's registered
# GPU_RL_ENV_DIR=/opt/marin/envs/rl (cloud/iris/gpu_rl_images.py).
ENV RL_ENV_DIR=/opt/marin/envs/rl
ENV UV_PROJECT_ENVIRONMENT=${RL_ENV_DIR}
# =============================================================================
# RE-LAYERED uv sync (packaging only — SAME lock, SAME closure, SAME versions).
# A single `uv sync --frozen` RUN puts the ENTIRE env (torch + all nvidia CUDA
# libs + flashinfer-jit-cache) into ONE very large layer, which ImagePullBackOffs
# indefinitely over the CoreWeave->ghcr egress (a single >8 GB blob never
# completes — ops doc coreweave_gpu_ops.md). kaniko emits ONE layer per RUN, so we
# split the SAME `uv sync --frozen` into a chain of identical syncs that defer the
# heavy packages one bucket at a time via `--no-install-package` (each package is
# installed by the FIRST sync that stops excluding it; the FINAL sync excludes
# nothing and guarantees the closure is exactly the lock — zero drift). Heavy
# buckets sized so no single layer exceeds ~4 GB.
# FlashAttention is excluded from every sync layer and installed from the compiled
# wheel below. Building the locked source distribution here would waste the
# wheel-builder stage and leave a redundant native-extension layer in the image.
# The Megatron-only native wheels use the same buckets as the amd64 image.
# =============================================================================
# `--no-cache` is essential here: otherwise uv's download cache is copied into
# each Kaniko RUN layer. In particular, the initial split layer reached 6.96 GiB
# even though its installed closure was much smaller, reintroducing the RNO
# ImagePullBackOff failure mode. The temporary cache leaves no pull payload.
ENV RL_SYNC=/usr/local/bin/sync-gpu-rl-env
# layer 0: all small packages + torch; defer the heavies.
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package flashinfer-jit-cache \
      --no-install-package nvidia-cudnn-cu12 \
      --no-install-package nvidia-cublas-cu12 \
      --no-install-package mamba-ssm --no-install-package causal-conv1d \
      --no-install-package nvidia-nccl-cu12 --no-install-package flashinfer-cubin --no-install-package transformer-engine-cu12 \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 0 (small pkgs + torch) done"
# layer 1: + flashinfer-jit-cache
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-cudnn-cu12 \
      --no-install-package nvidia-cublas-cu12 \
      --no-install-package mamba-ssm --no-install-package causal-conv1d \
      --no-install-package nvidia-nccl-cu12 --no-install-package flashinfer-cubin --no-install-package transformer-engine-cu12 \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 1 (flashinfer-jit-cache) done"
# layer 2: + nvidia-cudnn-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-cublas-cu12 \
      --no-install-package mamba-ssm --no-install-package causal-conv1d \
      --no-install-package nvidia-nccl-cu12 --no-install-package flashinfer-cubin --no-install-package transformer-engine-cu12 \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 2 (cudnn) done"
# layer 3: + nvidia-cublas-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package mamba-ssm --no-install-package causal-conv1d \
      --no-install-package nvidia-nccl-cu12 --no-install-package flashinfer-cubin --no-install-package transformer-engine-cu12 \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 3 (cublas) done"
# layer 4: + mamba-ssm + causal-conv1d (megatron-only)
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-nccl-cu12 --no-install-package flashinfer-cubin --no-install-package transformer-engine-cu12 \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 4 (mamba-ssm, causal-conv1d) done"
# layer 5: + nvidia-nccl-cu12 + flashinfer-cubin + transformer-engine-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-cusparse-cu12 --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 5 (nccl, flashinfer-cubin, transformer-engine-cu12) done"
# layers 6–8: install the three sparse/solver CUDA wheels separately.  The combined
# layer measured 7.48 GB in gpu-rl-megatron-cc408e74 and still EOFed on RNO's
# CoreWeave→GHCR pull path; each layer must stay near the proven <=3.5 GB profile.
# layer 6: + nvidia-cusparse-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-cusparselt-cu12 --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 6 (cusparse) done"
# layer 7: + nvidia-cusparselt-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package nvidia-cusolver-cu12 \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 7 (cusparselt) done"
# layer 8: + nvidia-cusolver-cu12
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} \
      --no-install-package vllm --no-install-package nvidia-cufft-cu12 --no-install-package triton --no-install-package nvidia-nvshmem-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 && \
    echo "uv sync layer 8 (cusolver) done"
# layer 9: FINAL — installs the remaining heavies. FlashAttention remains
# excluded because the compiled wheel below supplies the locked version.
RUN cd ${SKYRL_HOME} && \
    ${RL_SYNC} && \
    echo "uv sync FINAL (vllm, cufft, triton, nvshmem, nvrtc + closure verify) done (megatron=${INSTALL_MEGATRON})"

# Validate the wheels against the pins that produced them, then record provenance.
# There is no native donor on this image — the wheels are compiled in-tree from
# VLLM_FORK_COMMIT — so there is no donor commit or donor archive to record.
COPY --from=wheels /wheels /wheels
RUN printf '%s\n' \
      "VLLM_FORK_COMMIT=${VLLM_FORK_COMMIT}" \
      "FLASH_ATTN_VERSION=${FLASH_ATTN_VERSION}" \
      "TORCH_VERSION=${TORCH_VERSION}" \
      "TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}" \
      "CUDA=12.9 PY=cp312 PLATFORM=linux_aarch64" \
      > /tmp/expected-wheel-manifest && \
    cmp /tmp/expected-wheel-manifest /wheels/MANIFEST && \
    mkdir -p /opt/skyrl/provenance && \
    printf '%s\n' "${VLLM_FORK_COMMIT}" \
      > /opt/skyrl/provenance/vllm-source-commit && \
    sha256sum /wheels/vllm-*.whl \
      > /opt/skyrl/provenance/vllm-native-donor-wheel.sha256 && \
    sha256sum /wheels/flash_attn-*.whl \
      > /opt/skyrl/provenance/flash-attn-wheel.sha256

RUN uv pip install --python ${RL_ENV_DIR}/bin/python --no-deps /wheels/flash_attn-*.whl && \
    ${RL_ENV_DIR}/bin/python -c "import flash_attn, flash_attn_2_cuda; print('flash_attn', flash_attn.__version__, '+ flash_attn_2_cuda OK')"

# Install the exact fork source while extracting native files from the local
# donor wheel through vLLM's supported precompiled path.
ENV VLLM_FORK_DIR=/opt/vllm-fork
RUN git init -q "${VLLM_FORK_DIR}" && \
    git -C "${VLLM_FORK_DIR}" remote add origin "${VLLM_FORK_REPO}" && \
    git -C "${VLLM_FORK_DIR}" fetch --depth=1 origin "${VLLM_FORK_COMMIT}" && \
    git -C "${VLLM_FORK_DIR}" checkout -q --detach FETCH_HEAD && \
    test "$(git -C "${VLLM_FORK_DIR}" rev-parse HEAD)" = "${VLLM_FORK_COMMIT}"
RUN uv pip install --python ${RL_ENV_DIR}/bin/python --no-deps \
      "semantic-version==2.10.0" "setuptools-scm==9.2.2" \
      "setuptools-rust==1.12.0" "wheel==0.45.1" && \
    VLLM_NATIVE_WHEEL="$(find /wheels -maxdepth 1 -type f -name 'vllm-*.whl')" && \
    if ! VLLM_TARGET_DEVICE=cuda VLLM_USE_PRECOMPILED=1 \
      VLLM_PRECOMPILED_WHEEL_LOCATION="${VLLM_NATIVE_WHEEL}" \
      uv pip install --python ${RL_ENV_DIR}/bin/python --no-deps \
        --no-build-isolation "${VLLM_FORK_DIR}" -v \
        > /tmp/vllm-precompiled-install.log 2>&1; then \
      cat /tmp/vllm-precompiled-install.log; \
      exit 1; \
    fi && \
    grep -F "Using user-specified precompiled wheel location: ${VLLM_NATIVE_WHEEL}" \
      /tmp/vllm-precompiled-install.log && \
    grep -F "Using existing wheel at ${VLLM_NATIVE_WHEEL}" \
      /tmp/vllm-precompiled-install.log && \
    uv pip uninstall --python ${RL_ENV_DIR}/bin/python \
      setuptools-scm setuptools-rust wheel && \
    if [ "${INSTALL_MEGATRON}" != "1" ]; then \
      uv pip uninstall --python ${RL_ENV_DIR}/bin/python semantic-version; \
    fi && \
    rm /tmp/vllm-precompiled-install.log

# Primary assert: exact vLLM source + skyrl_train under the locked environment.
RUN ${RL_ENV_DIR}/bin/python -c "import torch, transformers, vllm, skyrl_train, flash_attn, flash_attn_2_cuda; print('torch', torch.__version__, '| transformers', transformers.__version__, '| vllm', vllm.__version__, '| flash_attn', flash_attn.__version__)"

# Verify the source metadata accepts the CUDA 12 runtime selected by the lock.
RUN ${RL_ENV_DIR}/bin/python -c "from importlib.metadata import distribution, version; from packaging.requirements import Requirement; requirements = [Requirement(value) for value in distribution('vllm').requires or []]; cutlass = next(value for value in requirements if value.name == 'nvidia-cutlass-dsl'); humming = next(value for value in requirements if value.name == 'humming-kernels'); assert cutlass.specifier.contains(version(cutlass.name)); assert humming.extras == {'cu12'}; assert humming.specifier.contains(version(humming.name)); print('vLLM CUDA 12 dependency metadata OK:', cutlass, humming)"

# Megatron backend asserts (only when built with INSTALL_MEGATRON=1).
# The second assert is stricter than the amd64 file's and is the point of this
# image: it proves the aarch64 TransformerEngine torch extension actually links,
# which is the one piece with no wheel on PyPI. torch is imported first because
# transformer_engine.common dlopens its core library at import time and finds
# libcudart only once torch has loaded the CUDA runtime.
RUN if [ "${INSTALL_MEGATRON}" = "1" ]; then \
        ${RL_ENV_DIR}/bin/python -c "import causal_conv1d, mamba_ssm, megatron.core, megatron.bridge, transformer_engine; print('Megatron native imports OK')" && \
        ${RL_ENV_DIR}/bin/python -c "import torch, transformer_engine.pytorch; from megatron.bridge.models.conversion.auto_bridge import AutoBridge; print('transformer_engine.pytorch + megatron.bridge AutoBridge import OK')"; \
    else echo "megatron backend not installed (INSTALL_MEGATRON=0)"; fi

# FSDP expert-parallel assert. Megatron selects a different policy dependency
# axis and is validated by the native imports above.
RUN if [ "${INSTALL_MEGATRON}" = "0" ]; then \
      ${RL_ENV_DIR}/bin/python -c "from torchtitan.distributed.expert_parallel import ExpertParallel; print('torchtitan ExpertParallel import OK (apply_ep EP>1 unblocked)')"; \
    else echo "FSDP torchtitan backend not installed (INSTALL_MEGATRON=1)"; fi

# The S3 client stack for the cloud.iris controller (Ray S3 object-spilling +
# the S3 rendezvous/checkpoint boto3 path) comes ENTIRELY through the frozen lock:
# Root pyproject.toml declares s3fs, smart_open, and boto3; the frozen lock resolves
# them to s3fs 2026.4.0, smart_open 8.0.1, and boto3 1.42.97. `uv sync --frozen`
# produces the whole stack — NO post-hoc pip (that was the drift vector). Assert it
# built correctly (imports + a boto3 S3 client ctor, which is exactly where the
# `compute_endpoint_resolver_builtin_defaults() missing 3 positional args` botocore
# skew surfaced on the stale lock).
RUN ${RL_ENV_DIR}/bin/python -c "import boto3, smart_open, s3fs; print('boto3', boto3.__version__, '| smart_open', smart_open.__version__, '| s3fs', s3fs.__version__)" && \
    ${RL_ENV_DIR}/bin/python -c "import boto3; boto3.client('s3', endpoint_url='https://example.invalid'); print('boto3 s3 client ctor OK (compute_endpoint_resolver skew cleared)')"

# Harbor and vLLM share FastAPI and OpenTelemetry; pin their validated overlap.
# The pip-check gate below always prints the full conflict report. Standard
# ARM64 has the two AMD64 metadata conflicts plus PyTorch's cusparselt wheel
# platform diagnostic. Megatron adds its three bridge diagnostics and the
# TransformerEngine platform diagnostic. The shared validator enumerates each;
# native imports above validate the selected ARM64 CUDA runtime.
#
# `analysis` and `datasets` were core harbor dependencies until 74d76ecb split
# them into extras, so every image up to that pin already carried them. Naming
# them keeps the closure the same rather than dropping two packages as a side
# effect of a verifier change. `datasets` also decides the gate: the lock pins
# datasets 4.0.0, which caps `fsspec[http]` at 2025.3.0 while the lock resolves
# fsspec 2026.4.0, so without the extra a second conflict appears.
COPY docker/validate_harbor_artifact_writer.py /tmp/validate_harbor_artifact_writer.py
COPY --chmod=0755 docker/validate_gpu_rl_pip_check.sh /usr/local/bin/validate-gpu-rl-pip-check
RUN uv pip install --python ${RL_ENV_DIR}/bin/python \
        "fastapi==${FASTAPI_VERSION}" \
        "opentelemetry-exporter-otlp==${OTEL_EXPORTER_VERSION}" \
        "harbor[analysis,datasets,daytona] @ git+https://github.com/marin-community/harbor.git@${HARBOR_COMMIT}" && \
    ${RL_ENV_DIR}/bin/python -c "import harbor, importlib.metadata as m; assert m.version('fastapi') == '${FASTAPI_VERSION}'; assert m.version('opentelemetry-exporter-otlp') == '${OTEL_EXPORTER_VERSION}'; print('harbor', m.version('harbor'))" && \
    ${RL_ENV_DIR}/bin/python /tmp/validate_harbor_artifact_writer.py && \
    rm /tmp/validate_harbor_artifact_writer.py && \
    if uv pip check --python ${RL_ENV_DIR}/bin/python > /tmp/rl-pip-check 2>&1; then \
      echo "expected the known runtime metadata conflicts"; \
      exit 1; \
    fi && \
    cat /tmp/rl-pip-check && \
    validate-gpu-rl-pip-check /tmp/rl-pip-check linux_aarch64 "${INSTALL_MEGATRON}" && \
    rm /tmp/rl-pip-check && \
    echo "baked harbor commit: ${HARBOR_COMMIT}"

# Profiler and callable-entrypoint support, baked so the task does not need iris's
# setup phase to supply them. iris normally installs cloudpickle/py-spy/memray into
# the venv it creates at $IRIS_WORKDIR/.venv; with EnvironmentSpec(setup_scripts=[])
# that phase is skipped entirely and the image is used as-is, so these have to be
# here. py-spy is what a wedge diagnosis attaches with, and losing it silently would
# cost the capability exactly when it is needed.
RUN uv pip install --python ${RL_ENV_DIR}/bin/python cloudpickle py-spy memray && \
    ${RL_ENV_DIR}/bin/python -c "import cloudpickle; print('cloudpickle', cloudpickle.__version__)" && \
    ${RL_ENV_DIR}/bin/py-spy --version && \
    ${RL_ENV_DIR}/bin/python -c "import memray; print('memray OK')"

# =============================================================================
# Environment configuration
# =============================================================================
# The baked editable skyrl-train tree is the trainer source used at runtime.
ENV PYTHONPATH="${SKYRL_HOME}/skyrl-train"

RUN echo "ulimit -n 65535" >> /etc/profile.d/skyrl-ulimit.sh

# rl-env activation helper (source the rl venv, then exec the command).
RUN printf '#!/bin/bash\nsource %s/bin/activate\nexec "$@"\n' "${RL_ENV_DIR}" > /usr/local/bin/rl-env && \
    chmod +x /usr/local/bin/rl-env

CMD ["bash"]
