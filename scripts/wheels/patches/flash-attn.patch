# FA2 2.8.3.post1 forces C++17 while Torch 2.14.1 requires C++20 at
# https://github.com/pytorch/pytorch/blob/v2.14.1/aten/src/ATen/ATen.h#L3
# and https://github.com/Dao-AILab/flash-attention/blob/a8aa52b1ab3e9ca574c8a33b3f35afc017ffa2e2/setup.py#L201
# Only the qualified CUDA branches need this patch. Remove when the upstream
# CUDA builder accepts Torch's required standard, or a qualified stable Torch
# profile accepts native C++17. Verify a clean native build plus the existing
# FA2/TE value, gradient and context-parallel gates on H100 and GB200.
diff --git a/setup.py b/setup.py
index d180c18..9a59ee7 100644
--- a/setup.py
+++ b/setup.py
@@ -201 +201 @@ if not SKIP_CUDA_BUILD and not IS_ROCM:
-    "-std=c++17",
+    "-std=c++20",
@@ -220 +220 @@ if not SKIP_CUDA_BUILD and not IS_ROCM:
-    compiler_c17_flag=["-O3", "-std=c++17"]
+    compiler_c17_flag=["-O3", "-std=c++20"]
